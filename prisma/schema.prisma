datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum OrderStatus {
  pending_payment
  paid
  shipped
  delivered
  abandoned
  cancelled
  refunded
  returned
}

enum SupportTicketStatus {
  open
  escalated
  closed
}

enum AdminRole {
  owner
  staff
}

enum NotificationChannel {
  whatsapp
  email
}

enum NotificationStatus {
  sent
  failed
  skipped
}

model Sector {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  display_order Int       @default(0)
  products      Product[]
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
}

model Product {
  id          String      @id @default(cuid())
  sector_id   String
  sector      Sector      @relation(fields: [sector_id], references: [id])
  name        String
  slug        String      @unique
  description String
  price_kobo  Int
  currency    String      @default("NGN")
  stock_qty   Int         @default(0)
  image_urls  String[]
  is_active   Boolean     @default(true)
  order_items     OrderItem[]
  reviews         ProductReview[]
  adjustment_logs StockAdjustmentLog[]
  stock_waitlist  StockWaitlist[]
  created_at      DateTime    @default(now())
  updated_at  DateTime    @updatedAt

  @@index([sector_id])
}

model Customer {
  id                  String   @id @default(cuid())
  name                String
  phone               String
  email               String   @unique
  whatsapp_opt_in     Boolean           @default(false)
  whatsapp_phone_e164 String?
  orders              Order[]
  addresses           CustomerAddress[]
  sessions            CustomerSession[]
  created_at          DateTime          @default(now())
  updated_at          DateTime          @updatedAt

  @@index([email])
  @@index([whatsapp_phone_e164])
}

model Order {
  id               String            @id @default(cuid())
  order_number     Int               @unique @default(autoincrement())
  customer_id      String
  customer         Customer          @relation(fields: [customer_id], references: [id])
  status           OrderStatus       @default(pending_payment)
  subtotal_kobo    Int
  total_kobo       Int
  currency         String            @default("NGN")
  delivery_address String
  courier_name     String?
  tracking_number  String?
  dispatch_notes   String?
  shipped_at       DateTime?
  delivered_at     DateTime?
  paid_at          DateTime?
  reminder_sent_at DateTime?
  abandoned_at     DateTime?
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt

  items            OrderItem[]
  payment          Payment?
  invoice          Invoice?
  receipt          Receipt?
  sales_ledger     SalesLedgerEntry?
  notifications    MessageNotificationLog[]
  support_tickets  SupportTicket[]

  @@index([customer_id])
  @@index([status])
  @@index([order_number])
  @@index([tracking_number])
  @@index([created_at])
}

model OrderItem {
  id                        String  @id @default(cuid())
  order_id                  String
  order                     Order   @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product_id                String?
  product                   Product? @relation(fields: [product_id], references: [id], onDelete: SetNull)
  product_name_snapshot     String
  unit_price_kobo_snapshot  Int
  qty                       Int
  line_total_kobo           Int

  @@index([order_id])
  @@index([product_id])
}

model Payment {
  id                 String   @id @default(cuid())
  order_id           String   @unique
  order              Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  paystack_reference String   @unique
  status             String
  amount_kobo        Int
  verified_at        DateTime @default(now())
  raw_payload_json   Json

  @@index([paystack_reference])
}

model Invoice {
  id             String   @id @default(cuid())
  order_id       String   @unique
  order          Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  invoice_number Int      @unique @default(autoincrement())
  pdf_url        String?
  issued_at      DateTime @default(now())

  @@index([invoice_number])
}

model Receipt {
  id             String   @id @default(cuid())
  order_id       String   @unique
  order          Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  receipt_number Int      @unique @default(autoincrement())
  pdf_url        String?
  issued_at      DateTime @default(now())

  @@index([receipt_number])
}

model SalesLedgerEntry {
  id                    String   @id @default(cuid())
  order_id              String   @unique
  order                 Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  amount_kobo           Int
  sector_breakdown_json Json
  recorded_at           DateTime @default(now())

  @@index([recorded_at])
}

model SupportTicket {
  id                  String              @id @default(cuid())
  whatsapp_phone_e164 String
  order_id            String?
  order               Order?              @relation(fields: [order_id], references: [id], onDelete: SetNull)
  message             String
  status              SupportTicketStatus @default(open)
  created_at          DateTime            @default(now())
  updated_at          DateTime            @updatedAt

  @@index([whatsapp_phone_e164])
  @@index([status])
}

model AdminUser {
  id                  String    @id @default(cuid())
  email               String    @unique
  password_hash       String
  role                AdminRole @default(owner)
  whatsapp_phone_e164 String?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  @@index([whatsapp_phone_e164])
}

model MessageNotificationLog {
  id            String              @id @default(cuid())
  order_id      String
  order         Order               @relation(fields: [order_id], references: [id], onDelete: Cascade)
  channel       NotificationChannel
  template_name String?
  status        NotificationStatus
  created_at    DateTime            @default(now())

  @@index([order_id])
  @@index([channel])
  @@index([status])
}

model ProductReview {
  id                String   @id @default(cuid())
  product_id        String
  product           Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  customer_name     String
  customer_email    String
  rating            Int      // 1 to 5 stars
  headline          String?
  comment           String
  photo_url         String?
  is_verified_buyer Boolean  @default(false)
  is_approved       Boolean  @default(true)
  helpful_votes     Int      @default(0)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@index([product_id])
  @@index([rating])
  @@index([is_approved])
  @@index([created_at])
}

model StockAdjustmentLog {
  id             String   @id @default(cuid())
  product_id     String
  product        Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  previous_stock Int
  new_stock      Int
  adjustment     Int
  reason         String?
  notes          String?
  created_at     DateTime @default(now())

  @@index([product_id])
  @@index([created_at])
}

model StockWaitlist {
  id         String   @id @default(cuid())
  product_id String
  product    Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  email      String
  phone      String?
  notified   Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([product_id])
  @@index([email])
}

model CustomerAddress {
  id             String   @id @default(cuid())
  customer_id    String
  customer       Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  label          String   @default("Home") // e.g. "Home", "Office", "Pick-up"
  recipient_name String
  phone          String
  street_address String
  city           String?
  state          String   // Nigerian State e.g. Lagos, Abuja, Rivers
  lga            String?  // Local Government Area
  is_default     Boolean  @default(false)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@index([customer_id])
  @@index([is_default])
}

model CustomerAuthCode {
  id         String   @id @default(cuid())
  email      String
  code       String
  expires_at DateTime
  used       Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([email])
  @@index([code])
}

model CustomerSession {
  id          String   @id @default(cuid())
  customer_id String
  customer    Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  token       String   @unique
  expires_at  DateTime
  created_at  DateTime @default(now())

  @@index([customer_id])
  @@index([token])
}

