datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum OrderStatus {
  pending_payment
  paid
  shipped
  delivered
  abandoned
  cancelled
  refunded
  returned
}

enum SupportTicketStatus {
  open
  escalated
  closed
}

enum ReturnStatus {
  requested
  approved
  rejected
  in_transit
  received
  refunded
  cancelled
}

enum ReturnReason {
  damaged_defective
  wrong_item_delivered
  quality_not_as_expected
  size_fit_issue
  changed_mind
  other
}

enum RefundMethod {
  original_payment
  store_credit
}

enum AdminRole {
  owner
  staff
}

enum NotificationChannel {
  whatsapp
  email
}

enum NotificationStatus {
  sent
  failed
  skipped
}

model Sector {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  display_order Int       @default(0)
  products      Product[]
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
}

model Product {
  id          String      @id @default(cuid())
  sector_id   String
  sector      Sector      @relation(fields: [sector_id], references: [id])
  name        String
  slug        String      @unique
  description String
  price_kobo  Int
  currency    String      @default("NGN")
  stock_qty   Int         @default(0)
  image_urls  String[]
  is_active   Boolean     @default(true)
  supports_engraving Boolean @default(false)
  order_items     OrderItem[]
  reviews         ProductReview[]
  adjustment_logs StockAdjustmentLog[]
  stock_waitlist  StockWaitlist[]
  return_items    ReturnItem[]
  primary_bundles       ProductBundle[]       @relation("PrimaryProductBundles")
  complementary_bundles ProductBundle[]       @relation("ComplementaryBundles")
  flash_sale_products   FlashSaleProduct[]
  questions             ProductQuestion[]
  created_at      DateTime    @default(now())
  updated_at  DateTime    @updatedAt

  @@index([sector_id])
}

model Customer {
  id                  String   @id @default(cuid())
  name                String
  phone               String
  email               String   @unique
  whatsapp_opt_in     Boolean           @default(false)
  whatsapp_phone_e164 String?
  loyalty_points      Int               @default(0)
  referral_code       String?           @unique
  referred_by_id      String?
  referred_by         Customer?         @relation("CustomerReferrals", fields: [referred_by_id], references: [id], onDelete: SetNull)
  referrals           Customer[]        @relation("CustomerReferrals")
  referral_rewards    ReferralReward[]  @relation("ReferrerRewards")
  orders              Order[]
  addresses           CustomerAddress[]
  sessions            CustomerSession[]
  return_requests     ReturnRequest[]
  loyalty_ledger      LoyaltyPointsLedger[]
  created_at          DateTime          @default(now())
  updated_at          DateTime          @updatedAt

  @@index([email])
  @@index([referral_code])
  @@index([whatsapp_phone_e164])
}

model Order {
  id               String            @id @default(cuid())
  order_number     Int               @unique @default(autoincrement())
  customer_id      String
  customer         Customer          @relation(fields: [customer_id], references: [id])
  status           OrderStatus       @default(pending_payment)
  subtotal_kobo    Int
  total_kobo       Int
  currency         String            @default("NGN")
  delivery_address String
  courier_name     String?
  tracking_number  String?
  dispatch_notes   String?
  shipped_at       DateTime?
  delivered_at     DateTime?
  paid_at          DateTime?
  reminder_sent_at DateTime?
  abandoned_at     DateTime?
  review_reminder_sent_at DateTime?
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt

  gift_card_discount_kobo Int      @default(0)
  items            OrderItem[]
  payment          Payment?
  invoice          Invoice?
  receipt          Receipt?
  sales_ledger     SalesLedgerEntry?
  notifications    MessageNotificationLog[]
  support_tickets  SupportTicket[]
  return_requests  ReturnRequest[]
  gift_card_redemptions GiftCardRedemption[]

  @@index([customer_id])
  @@index([status])
  @@index([order_number])
  @@index([tracking_number])
  @@index([created_at])
}

model OrderItem {
  id                        String  @id @default(cuid())
  order_id                  String
  order                     Order   @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product_id                String?
  product                   Product? @relation(fields: [product_id], references: [id], onDelete: SetNull)
  product_name_snapshot     String
  unit_price_kobo_snapshot  Int
  qty                       Int
  line_total_kobo           Int
  custom_engraving          String?
  engraving_font            String?
  gift_wrap                 Boolean @default(false)
  return_items              ReturnItem[]

  @@index([order_id])
  @@index([product_id])
}

model Payment {
  id                 String   @id @default(cuid())
  order_id           String   @unique
  order              Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  paystack_reference String   @unique
  status             String
  amount_kobo        Int
  verified_at        DateTime @default(now())
  raw_payload_json   Json

  @@index([paystack_reference])
}

model Invoice {
  id             String   @id @default(cuid())
  order_id       String   @unique
  order          Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  invoice_number Int      @unique @default(autoincrement())
  pdf_url        String?
  issued_at      DateTime @default(now())

  @@index([invoice_number])
}

model Receipt {
  id             String   @id @default(cuid())
  order_id       String   @unique
  order          Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  receipt_number Int      @unique @default(autoincrement())
  pdf_url        String?
  issued_at      DateTime @default(now())

  @@index([receipt_number])
}

model SalesLedgerEntry {
  id                    String   @id @default(cuid())
  order_id              String   @unique
  order                 Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  amount_kobo           Int
  sector_breakdown_json Json
  recorded_at           DateTime @default(now())

  @@index([recorded_at])
}

model SupportTicket {
  id                  String              @id @default(cuid())
  customer_name       String?
  customer_email      String?
  whatsapp_phone_e164 String
  subject             String?
  order_id            String?
  order               Order?              @relation(fields: [order_id], references: [id], onDelete: SetNull)
  message             String
  admin_notes         String?
  resolution_notes    String?
  status              SupportTicketStatus @default(open)
  created_at          DateTime            @default(now())
  updated_at          DateTime            @updatedAt

  @@index([whatsapp_phone_e164])
  @@index([status])
}

model AdminUser {
  id                  String    @id @default(cuid())
  email               String    @unique
  password_hash       String
  role                AdminRole @default(owner)
  whatsapp_phone_e164 String?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  @@index([whatsapp_phone_e164])
}

model MessageNotificationLog {
  id            String              @id @default(cuid())
  order_id      String
  order         Order               @relation(fields: [order_id], references: [id], onDelete: Cascade)
  channel       NotificationChannel
  template_name String?
  status        NotificationStatus
  created_at    DateTime            @default(now())

  @@index([order_id])
  @@index([channel])
  @@index([status])
}

model ProductReview {
  id                String   @id @default(cuid())
  product_id        String
  product           Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  customer_name     String
  customer_email    String
  rating            Int      // 1 to 5 stars
  headline          String?
  comment           String
  photo_url         String?
  is_verified_buyer Boolean  @default(false)
  is_approved       Boolean  @default(true)
  helpful_votes     Int      @default(0)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@index([product_id])
  @@index([rating])
  @@index([is_approved])
  @@index([created_at])
}

model StockAdjustmentLog {
  id             String   @id @default(cuid())
  product_id     String
  product        Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  previous_stock Int
  new_stock      Int
  adjustment     Int
  reason         String?
  notes          String?
  created_at     DateTime @default(now())

  @@index([product_id])
  @@index([created_at])
}

model StockWaitlist {
  id         String   @id @default(cuid())
  product_id String
  product    Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  email      String
  phone      String?
  notified   Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([product_id])
  @@index([email])
}

model CustomerAddress {
  id             String   @id @default(cuid())
  customer_id    String
  customer       Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  label          String   @default("Home") // e.g. "Home", "Office", "Pick-up"
  recipient_name String
  phone          String
  street_address String
  city           String?
  state          String   // Nigerian State e.g. Lagos, Abuja, Rivers
  lga            String?  // Local Government Area
  is_default     Boolean  @default(false)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@index([customer_id])
  @@index([is_default])
}

model CustomerAuthCode {
  id         String   @id @default(cuid())
  email      String
  code       String
  expires_at DateTime
  used       Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([email])
  @@index([code])
}

model CustomerSession {
  id          String   @id @default(cuid())
  customer_id String
  customer    Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  token       String   @unique
  expires_at  DateTime
  created_at  DateTime @default(now())

  @@index([customer_id])
  @@index([token])
}

model ReturnRequest {
  id                  String         @id @default(cuid())
  rma_number          String         @unique // e.g. "RMA-2026-0001"
  order_id            String
  order               Order          @relation(fields: [order_id], references: [id], onDelete: Cascade)
  customer_id         String
  customer            Customer       @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  status              ReturnStatus   @default(requested)
  reason              ReturnReason
  customer_note       String?
  evidence_images     String[]       // Evidence photo URLs or proof strings
  refund_method       RefundMethod   @default(original_payment)
  pickup_address      String?
  return_courier      String?        // e.g. "GIG Logistics", "Fez Delivery", "Speedaf", "Gokada", "DHL"
  return_tracking_num String?
  admin_notes         String?
  rejection_reason    String?
  refund_amount_kobo  Int            @default(0)
  refund_reference    String?        // Paystack refund ID or Store Credit promo code
  restocked           Boolean        @default(false)
  approved_at         DateTime?
  in_transit_at       DateTime?
  received_at         DateTime?
  refunded_at         DateTime?
  created_at          DateTime       @default(now())
  updated_at          DateTime       @updatedAt

  items               ReturnItem[]

  @@index([order_id])
  @@index([customer_id])
  @@index([status])
  @@index([rma_number])
}

model ReturnItem {
  id                    String        @id @default(cuid())
  return_request_id     String
  return_request        ReturnRequest @relation(fields: [return_request_id], references: [id], onDelete: Cascade)
  order_item_id         String
  order_item            OrderItem     @relation(fields: [order_item_id], references: [id], onDelete: Cascade)
  product_id            String?
  product               Product?      @relation(fields: [product_id], references: [id], onDelete: SetNull)
  product_name_snapshot String
  unit_price_kobo       Int
  qty                   Int
  item_refund_kobo      Int

  @@index([return_request_id])
  @@index([order_item_id])
  @@index([product_id])
}

model ProductBundle {
  id              String   @id @default(cuid())
  product_id      String
  product         Product  @relation("PrimaryProductBundles", fields: [product_id], references: [id], onDelete: Cascade)
  bundle_item_id  String
  bundle_item     Product  @relation("ComplementaryBundles", fields: [bundle_item_id], references: [id], onDelete: Cascade)
  created_at      DateTime @default(now())

  @@unique([product_id, bundle_item_id])
  @@index([product_id])
  @@index([bundle_item_id])
}

model LoyaltyPointsLedger {
  id          String   @id @default(cuid())
  customer_id String
  customer    Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  order_id    String?
  points      Int
  reason      String
  created_at  DateTime @default(now())

  @@index([customer_id])
  @@index([order_id])
  @@index([created_at])
}

model ReferralReward {
  id              String   @id @default(cuid())
  referrer_id     String
  referrer        Customer @relation("ReferrerRewards", fields: [referrer_id], references: [id], onDelete: Cascade)
  referee_id      String?
  order_id        String?
  reward_points   Int      @default(500)
  status          String   @default("awarded") // awarded, pending, cancelled
  created_at      DateTime @default(now())

  @@index([referrer_id])
  @@index([referee_id])
  @@index([order_id])
}

model AdminNotification {
  id           String   @id @default(cuid())
  type         String   // order_paid, low_stock, rma_requested, ticket_opened, order_shipped
  title        String
  message      String
  link         String?
  reference_id String?
  is_read      Boolean  @default(false)
  created_at   DateTime @default(now())

  @@index([is_read])
  @@index([created_at])
  @@index([type])
}

model FlashSale {
  id                  String             @id @default(cuid())
  title               String
  description         String?
  discount_percentage Int                // e.g. 25 for 25% OFF
  banner_text         String?            // e.g. "⚡ Flash Sale: 25% OFF on Premium Collections!"
  start_time          DateTime
  end_time            DateTime
  is_active           Boolean            @default(true)
  created_at          DateTime           @default(now())
  updated_at          DateTime           @updatedAt
  products            FlashSaleProduct[]

  @@index([is_active])
  @@index([start_time, end_time])
}

model FlashSaleProduct {
  id            String    @id @default(cuid())
  flash_sale_id String
  flash_sale    FlashSale @relation(fields: [flash_sale_id], references: [id], onDelete: Cascade)
  product_id    String
  product       Product   @relation(fields: [product_id], references: [id], onDelete: Cascade)
  created_at    DateTime  @default(now())

  @@unique([flash_sale_id, product_id])
  @@index([flash_sale_id])
  @@index([product_id])
}

model GiftCard {
  id                 String               @id @default(cuid())
  code               String               @unique
  initial_value_kobo Int
  balance_kobo       Int
  currency           String               @default("NGN")
  recipient_name     String?
  recipient_email    String?
  sender_name        String?
  message            String?
  is_active          Boolean              @default(true)
  expires_at         DateTime?
  created_at         DateTime             @default(now())
  updated_at         DateTime             @updatedAt
  redemptions        GiftCardRedemption[]

  @@index([code])
  @@index([is_active])
}

model GiftCardRedemption {
  id           String   @id @default(cuid())
  gift_card_id String
  gift_card    GiftCard @relation(fields: [gift_card_id], references: [id], onDelete: Cascade)
  order_id     String
  order        Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  amount_kobo  Int
  redeemed_at  DateTime @default(now())

  @@index([gift_card_id])
  @@index([order_id])
}

model ProductQuestion {
  id             String          @id @default(cuid())
  product_id     String
  product        Product         @relation(fields: [product_id], references: [id], onDelete: Cascade)
  customer_name  String
  customer_email String?
  question       String
  is_approved    Boolean         @default(true)
  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt
  answers        ProductAnswer[]

  @@index([product_id])
  @@index([is_approved])
}

model ProductAnswer {
  id            String          @id @default(cuid())
  question_id   String
  question      ProductQuestion @relation(fields: [question_id], references: [id], onDelete: Cascade)
  answered_by   String
  answer        String
  is_official   Boolean         @default(true)
  helpful_count Int             @default(0)
  created_at    DateTime        @default(now())
  updated_at    DateTime        @updatedAt

  @@index([question_id])
}


