# Database
DATABASE_URL="postgresql://user:password@localhost:5432/ecommerce?schema=public"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Paystack
PAYSTACK_SECRET_KEY="sk_test_xxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxx"

# WhatsApp Cloud API (Direct via Meta)
WHATSAPP_PHONE_NUMBER_ID="your_phone_number_id"
WHATSAPP_ACCESS_TOKEN="your_permanent_system_user_token"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="your_custom_webhook_verify_token"
WHATSAPP_APP_SECRET="your_meta_app_secret"

# Email (Resend)
RESEND_API_KEY="re_xxx"
RESEND_FROM_EMAIL="orders@yourdomain.com"

# Object Storage (R2 / S3-compatible) - for invoice/receipt PDFs
S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID="your_access_key"
S3_SECRET_ACCESS_KEY="your_secret_key"
S3_BUCKET_NAME="ecommerce-receipts"

# Cron Secret
CRON_SECRET="your_secure_cron_secret"

# First admin sign-in, used by `npx tsx prisma/seed.ts`.
# ADMIN_SEED_PASSWORD must be a real value (e.g. `openssl rand -hex 16`) — the seed refuses
# to run with it empty rather than creating an admin that cannot sign in. It is not read by
# the app at runtime, so it can be removed from the environment once the account exists.
ADMIN_SEED_EMAIL="admin@store.com"
ADMIN_SEED_PASSWORD=""
